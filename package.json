{
  "name": "js-compiled",
  "version": "0.0.0",
  "description": "Benchmarking JavaScript/TypeScript runtimes against ahead-of-time native compilers",
  "scripts": {
    "test": "node --test harness/*.test.mjs",
    "setup": "scripts/setup.sh",
    "bench": "node harness/run.mjs",
    "report": "node harness/report.mjs",
    "merge": "node harness/merge.mjs"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@assemblyscript/wasi-shim": "0.1.0",
    "@geastack/compiler": "1.0.18",
    "@loopdive/js2": "0.71.0",
    "@perryts/perry": "0.5.1520",
    "assemblyscript": "0.28.20",
    "binaryen": "132.0.0",
    "scriptc": "0.1.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@scriptc/llvm-darwin-x64": "0.1.0",
    "@scriptc/runtime-darwin-x64": "0.1.0"
  },
  "allowScripts": {
    "scriptc@0.1.4": true
  },
  "private": true
}
